# Stable repository bytes and cross-platform diffs
* text=auto eol=lf

*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sha256 text eol=lf
VERSION text eol=lf
LICENSE text eol=lf

# Binary artifacts are not part of the source release, but remain binary if added locally
*.prg binary
*.png binary
*.bmp binary
*.gif binary
*.zip binary

# Byte-preserved qualification/history inputs; do not normalize line endings.
LICENSE-DOCUMENTATION.md -text
scripts/test_distance_fade_layout.py -text
work/distance_fade_legacy.py -text
work/legacy_gouraud_coherent.py -text
work/legacy_wire_segment_clip.py -text
work/mode8/build.py -text
work/normalized_build.py -text
work/q8/build.py -text
work/q8/src/wire_build.py -text
*.bin binary
